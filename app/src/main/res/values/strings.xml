    <!-- Settings Screen -->
    <string name="settings_sec_gemini">Gemini</string>
    <string name="settings_api_key_title">API key</string>
    <string name="settings_api_key_desc">Your own key, encrypted with Android Keystore on this phone. Used only for requests the phone can\'t handle. Gemini usage counts against your key\'s limits.</string>
    <string name="settings_model_desc">Live model used for voice conversations: %s</string>
    <string name="settings_model_dialog_title">Gemini Live model</string>
    <string name="settings_model_dialog_desc">Select a model or enter a custom name:</string>
    <string name="settings_model_name_label">Model name</string>
    <string name="settings_default_assistant_title">Default assistant</string>
    <string name="settings_default_assistant_desc">Long-press Home or swipe from a corner to talk.</string>
    <string name="settings_sec_conversation">Conversation</string>
    <string name="settings_reply_lang_desc">Language %1$s replies in: %2$s</string>
    <string name="settings_talk_over_title">Talk over %s</string>
    <string name="settings_talk_over_desc">Speak while it answers to cut it off, also on the loudspeaker. An echo canceller on this phone removes its own voice first. Turn off if it cuts itself off.</string>
    <string name="settings_wave_title">Wave to interrupt</string>
    <string name="settings_wave_desc">Wave a hand over the top of the phone while %s speaks to cut it off. With headphones you can also just talk over it.</string>
    <string name="settings_sec_orb">Floating orb</string>
    <string name="settings_orb_title">Use %s over any app</string>
    <string name="settings_orb_desc">A small orb floats over your apps. Tap to talk, double-tap to type, drag to move. Needs \"Display over other apps\"; it hides while %s is open.</string>
    <string name="settings_sec_notifications">Notifications</string>
    <string name="settings_miss_title">What did I miss?</string>
    <string name="settings_miss_desc">%1$sAsk \"what did I miss?\" and hear messages from people first. Notifications stay in memory on this phone; Gemini gets a short summary only when you ask, with codes hidden.</string>
    <string name="settings_state_on">On. </string>
    <string name="settings_state_off">Off. </string>
    <string name="settings_wake_title">Say \"%s\"</string>
    <string name="settings_wake_desc">Heard on this phone only. Test model: not for release builds.</string>
    <string name="settings_wake_not_build_title">Not in this build</string>
    <string name="settings_wake_not_build_desc">The wake word ships once %s has its own model.</string>
    <string name="settings_sec_local">Local commands</string>
    <string name="settings_local_title">Handle simple commands on the phone</string>
    <string name="settings_local_desc">Volume, music, flashlight, apps, time, timers and alarms run here, without Gemini.</string>
    <string name="settings_network_title">Use the phone\'s speech service</string>
    <string name="settings_network_desc">Better recognition, but sends what you say after the wake word to that service (usually Google) and needs internet. Off: speech stays on this phone.</string>
    <string name="settings_speech_heard_title">Speech heard by</string>
    <string name="engine_on_device">The phone\'s on-device recogniser. No internet needed.</string>
    <string name="engine_offline">Offline model on this phone (Vosk). No internet needed; best with English words.</string>
    <string name="engine_network">The phone\'s speech service (usually Google). Needs internet.</string>
    <string name="engine_none">Nothing local is available, so Gemini hears every request.</string>
    <string name="settings_sec_learning">Learning</string>
    <string name="settings_learn_title">Learn from how I use %s</string>
    <string name="settings_learn_desc">Kept only on this phone: which commands you use and when, and your own phrases once Gemini has understood them. Never contacts.</string>
    <string name="settings_learned_title">What it knows</string>
    <string name="settings_sec_permissions">Permissions</string>
    <string name="settings_battery_title">Background running</string>
    <string name="settings_battery_allowed">Allowed. The phone won\'t stop the wake word.</string>
    <string name="settings_battery_disallowed">The phone may stop the wake word to save battery. Allow %s under Battery → Unrestricted.</string>
    <string name="settings_sec_privacy">Privacy</string>
    <string name="settings_privacy_leaves_title">What leaves the phone</string>
    <string name="settings_privacy_leaves_desc">The wake word and local commands stay on this phone. Gemini gets only requests the phone can\'t handle. Nothing is recorded. The diagnostic log keeps timings and states, never your words.</string>
    <string name="settings_standby_title">Standby</string>
    <string name="settings_standby_desc">Between requests only the wake word runs; Gemini is disconnected.</string>
    <string name="settings_remembers_title">What %s remembers</string>
    <string name="settings_remembers_desc">%d note(s) you asked it to remember, kept on this phone only. Gemini sees one only when you ask about it.</string>
    <string name="settings_sec_about">About</string>
    <string name="settings_version">Version %s</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_desc">A voice assistant for your phone, in English and Bengali.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_key_title">Your Gemini key</string>
    <string name="onboarding_key_desc">%s uses Google Gemini, with your own key, for anything the phone can\'t do by itself.</string>
    <string name="onboarding_key_saved">Your key is saved and checked.</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_where_title">What runs where</string>
    <string name="onboarding_where_desc">Simple commands never leave the phone. The rest goes to Gemini.</string>
    <string name="onboarding_local_title">On this phone</string>
    <string name="onboarding_local_desc">Volume, music, flashlight, opening apps, time, battery, timers and alarms. No internet, no Gemini.</string>
    <string name="onboarding_gemini_title">With Gemini</string>
    <string name="onboarding_gemini_desc">Questions, calls and messages, songs by name, your screen. Needs internet and uses your key.</string>
    <string name="onboarding_handsfree_title">Hands-free</string>
    <string name="onboarding_handsfree_desc">Say \"%s\" instead of touching the phone. It listens on the phone only; nothing is sent until you say it.</string>
    <string name="onboarding_wake_desc">Uses a little battery while it waits.</string>
    <string name="onboarding_mic_first">Allow the microphone first (Settings → Permissions).</string>
    <string name="onboarding_not_in_build">Not in this build yet.</string>
    <string name="onboarding_control_title">Phone control (optional)</string>
    <string name="onboarding_control_desc">Lets %s read the screen and tap for you, e.g. press Play or fill in a message. You can turn it on later in Settings.</string>
    <string name="onboarding_skip">Skip for now</string>
    <string name="onboarding_done_title">You\'re set</string>
    <string name="onboarding_done_desc">Say \"%s\" or tap the mic. Settings has everything you chose here.</string>
    <string name="onboarding_start">Start</string>
    <string name="onboarding_mic_title">Microphone</string>
    <string name="onboarding_mic_desc">Needed to hear you. Audio for the wake word and local commands stays on the phone; Gemini hears you only during a conversation with it.</string>
    <string name="onboarding_mic_allowed">Microphone allowed.</string>
    <string name="onboarding_allow_mic">Allow microphone</string>
    <string name="onboarding_not_now">Not now</string>

