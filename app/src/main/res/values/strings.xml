    <!-- Automations Screen -->
    <string name="automations_title">Automations</string>
    <string name="automations_subtitle">Say \"%s\", then the command. English and Bengali.</string>
    <string name="routines_title">Routines</string>
    <string name="routines_description">Say a routine\'s name to run its steps. Make one by voice: \"make a routine called good night: alarm at 6:30, what\'s on tomorrow\".</string>
    <string name="group_on_phone_title">On this phone</string>
    <string name="group_on_phone_desc">Works without internet and doesn\'t use your Gemini key.</string>
    <string name="group_tasks_title">Tasks with your OK</string>
    <string name="group_tasks_desc">Gemini plans them; you finish anything that sends, calls or pays.</string>
    <string name="group_cloud_title">With Gemini</string>
    <string name="group_cloud_desc">Needs internet; uses your Gemini key.</string>

    <!-- Automations Commands -->
    <string name="cmd_volume">Volume</string>
    <string name="cmd_volume_eg">\"Set volume to 30 percent\" · \"volume up\" · \"mute phone\"</string>
    <string name="cmd_music">Music</string>
    <string name="cmd_music_eg">\"Pause music\" · \"next song\" · \"resume\"</string>
    <string name="cmd_flashlight">Flashlight</string>
    <string name="cmd_flashlight_eg">\"Turn on flashlight\" · \"turn off torch\"</string>
    <string name="cmd_open_apps">Open apps</string>
    <string name="cmd_open_apps_eg">\"Open YouTube\" · \"open Calendar\" · \"launch Camera\"</string>
    <string name="cmd_time_date_battery">Time, date, battery</string>
    <string name="cmd_time_date_battery_eg">\"What\'s the time?\" · \"what day is it\" · \"battery level\"</string>
    <string name="cmd_timers_alarms">Timers and alarms</string>
    <string name="cmd_timers_alarms_eg">\"5 minute timer\" · \"alarm at 6:30 am\"</string>
    <string name="cmd_stop">Stop</string>
    <string name="cmd_stop_eg">\"Stop\" · \"cancel\" · \"never mind\"</string>
    <string name="cmd_whatsapp">WhatsApp message</string>
    <string name="cmd_whatsapp_eg">\"Tell Rahul on WhatsApp that I will arrive at 7\". Asks if several Rahuls match, opens the chat with the message; you check it and tap Send. With phone control on, it only says \"sent\" once the message shows in the chat.</string>
    <string name="cmd_movie_tickets">Movie tickets</string>
    <string name="cmd_movie_tickets_eg">\"Book 4 tickets for tomorrow evening\". Opens your ticket app or a web search; you pick the show and seats and pay there. It never pays or books for you.</string>
    <string name="cmd_calls">Calls</string>
    <string name="cmd_calls_eg">\"Call Mom\". Asks for confirmation with the number, then places the call directly or opens the dialer.</string>
    <string name="cmd_songs">Songs</string>
    <string name="cmd_songs_eg">\"Play music on YouTube Music\"</string>
    <string name="cmd_screen">Your screen</string>
    <string name="cmd_screen_eg">\"What\'s on my screen?\" · \"reply to this\" (needs phone control)</string>
    <string name="cmd_questions">Questions</string>
    <string name="cmd_questions_eg">Weather, facts, explanations, anything else</string>
    <string name="cmd_reminders">Reminders</string>
    <string name="cmd_reminders_eg">\"Remind me to call at 5\"</string>

