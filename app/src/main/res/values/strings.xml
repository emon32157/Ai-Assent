    <string name="app_name">JARVIS</string>
    <string name="control_label">Phone control (voice assistant)</string>
    <string name="control_description">Lets the assistant read what\'s on your screen and tap, type and scroll for you, only when you ask by voice. Taps that send, call, delete or pay wait for you to press Allow. It never reads banking, UPI, password or Settings apps, and doesn\'t store or upload what it reads except to answer you through Gemini.</string>

