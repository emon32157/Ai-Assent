    <!-- Control Card -->
    <string name="control_card_title">Phone control</string>
    <string name="control_card_on_desc">On. Send, call, delete and pay still wait for your Allow.</string>
    <string name="control_card_off_title">Phone control is off</string>
    <string name="control_card_off_desc">Turn it on so %s can read your screen and tap, type and scroll when you ask, e.g. play a song or reply in WhatsApp. Send, call, delete and pay always wait for you to tap Allow. Banking, MFS, UPI, password and Settings apps are never read.</string>
    <string name="control_card_switch_greyed">Switch greyed out?</string>
    <string name="control_card_restricted_hint">If the switch is grey: App info → ⋮ (top right) → Allow restricted settings, then try again.</string>

    <!-- Key Form -->
    <string name="key_form_desc">Keys are made in Google AI Studio. The free tier has usage limits; paid use is billed to your Google account. The key is checked with Google, then kept encrypted on this phone.</string>
    <string name="key_form_link">Get a key at Google AI Studio</string>
    <string name="key_form_label">Gemini API key</string>
    <string name="key_form_checking">Checking with Google…</string>
    <string name="key_form_save">Check and save</string>

    <!-- Voice Setup Dialog -->
    <string name="voice_setup_title">Teach %s your voice</string>
    <string name="voice_setup_sample_progress">Sample %1$d of %2$d</string>
    <string name="voice_setup_instruction">Tap Record, wait for \"Say it now\", then say \"%s\" normally.</string>
    <string name="voice_setup_privacy">Kept only on this phone as speech features, not recordings. You can forget it any time.</string>
    <string name="voice_setup_ready">Get ready…</string>
    <string name="voice_setup_say_now">Say \"%s\" now</string>
